<?xml version="1.0" encoding="utf-8"?>
<!-- One row in Home's timetable list. Inflated programmatically per ScheduleRunEntity by
     HomeActivity — matches the reference app's own approach of a plain LinearLayout container
     instead of a RecyclerView/Adapter, since run counts here are the same "small, refreshed on
     resume" shape their saved-tests list was built for. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CardRow">

    <ImageView
        android:id="@+id/ivRowIcon"
        style="@style/CardRowIconCircle"
        android:src="@drawable/ic_timetable"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvRowTitle"
            style="@style/CardRowTitle"
            android:text="Timetable name" />

        <TextView
            android:id="@+id/tvRowSubtitle"
            style="@style/CardRowSubtitle"
            android:text="Class Schedule • DSATUR • Aug 6" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRowStatus"
        style="@style/StatusPill"
        android:background="@drawable/bg_pill_rounded"
        android:layout_marginEnd="8dp"
        android:text="CLEAN" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textSize="20sp"
        android:alpha="0.4"
        android:textColor="?android:attr/textColorPrimary" />
</LinearLayout>
