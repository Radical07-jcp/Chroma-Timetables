<?xml version="1.0" encoding="utf-8"?>
<!-- Nav drawer content, structured the same way as the reference app's own drawer_content.xml:
     header block (logo + two-line CHROMA / TIMETABLES title + tagline) on a solid navy background,
     a scrollable list of icon+label rows grouped under section headers, and a footer pinned outside
     the ScrollView so it never scrolls out of view. Rows are plain LinearLayouts (not a
     ListView/RecyclerView) since the item count is small and fixed at layout time, same reasoning
     as the reference app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/chroma_navy"
        android:padding="20dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/ic_launcher_foreground"
            android:contentDescription="@string/app_name" />

        <!-- CHROMA / TIMETABLES header: same two-line, big-then-small pattern as activity_home.xml's
             own header — see that file for the full rationale. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_horizontal"
            android:text="@string/header_line1"
            android:textColor="@color/chroma_white"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_horizontal"
            android:text="@string/header_line2"
            android:textColor="@color/chroma_white"
            android:letterSpacing="0.12"
            android:textSize="9sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:text="@string/drawer_tagline"
            android:textColor="@color/chroma_white"
            android:alpha="0.75"
            android:letterSpacing="0.06"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <TextView style="@style/DrawerSectionHeader" android:text="SCHEDULING" />

            <LinearLayout android:id="@+id/drawerImportData" style="@style/DrawerRow">
                <ImageView style="@style/DrawerRowIcon" android:src="@drawable/ic_import" android:contentDescription="@null" />
                <TextView style="@style/DrawerRowLabel" android:text="Import Data" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerGenerateSchedule" style="@style/DrawerRow">
                <ImageView style="@style/DrawerRowIcon" android:src="@drawable/ic_generate" android:contentDescription="@null" />
                <TextView style="@style/DrawerRowLabel" android:text="Generate New Schedule" />
            </LinearLayout>

            <LinearLayout android:id="@+id/drawerDefinePeriods" style="@style/DrawerRow">
                <ImageView style="@style/DrawerRowIcon" android:src="@drawable/ic_periods" android:contentDescription="@null" />
                <TextView style="@style/DrawerRowLabel" android:text="Define Periods" />
            </LinearLayout>

            <TextView style="@style/DrawerSectionHeader" android:text="DATA" />

            <LinearLayout android:id="@+id/drawerTeachers" style="@style/DrawerRow">
                <ImageView style="@style/DrawerRowIcon" android:src="@drawable/ic_teachers" android:contentDescription="@null" />
                <TextView style="@style/DrawerRowLabel" android:text="Teachers" />
            </LinearLayout>

            <TextView style="@style/DrawerSectionHeader" android:text="PREFERENCES" />

            <LinearLayout android:id="@+id/drawerSettings" style="@style/DrawerRow">
                <ImageView style="@style/DrawerRowIcon" android:src="@drawable/ic_sliders" android:contentDescription="@null" />
                <TextView style="@style/DrawerRowLabel" android:text="Settings" />
            </LinearLayout>

            <TextView style="@style/DrawerSectionHeader" android:text="SUPPORT" />

            <LinearLayout android:id="@+id/drawerAbout" style="@style/DrawerRow">
                <ImageView style="@style/DrawerRowIcon" android:src="@drawable/ic_help_circle" android:contentDescription="@null" />
                <TextView style="@style/DrawerRowLabel" android:text="About / No AI, on-device only" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v0.1.0"
            android:textColor="?android:attr/textColorPrimary"
            android:alpha="0.6"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Deterministic graph-coloring engine • no AI"
            android:textColor="?android:attr/textColorPrimary"
            android:alpha="0.55"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
